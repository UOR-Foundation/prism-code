{
  "name": "UOR PrismPM SDK (Codespaces)",
  "image": "ghcr.io/uor-foundation/prismpm-sdk-candidate@sha256:cd3b47d7a370c4a26b8285f5e9c3bb15e639973c55505c3809ddbe55352fea58",
  "containerUser": "root",
  "remoteUser": "vscode",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "overrideCommand": false,
  "runArgs": [
    "--init"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "leanprover.lean4",
        "rust-lang.rust-analyzer"
      ]
    }
  },
  "onCreateCommand": "npm exec --yes --no-audit --no-fund prism-code@0.2.0 -- --help > /dev/null",
  "postCreateCommand": "prismpm template check && prismpm lock check"
}
